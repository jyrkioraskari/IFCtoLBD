PREFIX bot: <https://w3id.org/bot#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ifctolbd: <https://w3id.org/ifctolbd/mapping#>

SELECT ?insulation ?wall ?reviewEvidence WHERE {
  ?interface a bot:Interface ;
             bot:interfaceOf ?insulation, ?wall ;
             ifctolbd:interfaceOrigin ifctolbd:ReviewedPair ;
             ifctolbd:reviewEvidence ?reviewEvidence .
  ?insulation a bot:Element ; rdfs:label "Renovation insulation" .
  ?wall a bot:Element ; rdfs:label "Existing wall" .
}
ORDER BY ?insulation ?wall
