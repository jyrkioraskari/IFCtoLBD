PREFIX bot: <https://w3id.org/bot#>
PREFIX mep: <https://pi.pauwel.be/voc/distributionelement#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX supply: <https://w3id.org/ifctolbd/supply-chain#>

SELECT DISTINCT ?identifier ?candidate ?status ?propertySet ?property ?value ?datatype ?unit ?support ?conflict ?missing WHERE {
  VALUES ?subtype { <https://identifier.buildingsmart.org/uri/etim/etim/10.0/class/EC010980> }
  ?pump a bot:Element, mep:Pump ; rdfs:label ?identifier .
  FILTER NOT EXISTS {
    ?pump supply:hasClassification ?assertion .
    ?assertion supply:resolvedConcept ?subtype ;
               supply:classificationStatus ?origin .
    FILTER (?origin IN ("supplied", "accepted"))
  }
  {
    ?pump supply:hasClassificationSuggestion ?selectedReview .
    ?selectedReview supply:suggestedConcept ?subtype .
    BIND(?subtype AS ?candidate)
    BIND("suggested" AS ?status)
  }
  UNION {
    ?pump supply:hasClassificationAssessment ?selectedReview .
    ?selectedReview supply:consideredConcept ?subtype ;
                    supply:classificationStatus ?status .
    BIND(?subtype AS ?candidate)
  }
  UNION {
    # Bind this pump before testing for other candidates.
    ?pump a mep:Pump .
    FILTER NOT EXISTS { ?pump supply:hasClassificationSuggestion ?otherSuggestion }
    ?pump supply:hasClassificationAssessment ?selectedReview .
    ?selectedReview supply:classificationStatus ?status .
    FILTER NOT EXISTS { ?selectedReview supply:consideredConcept ?otherConcept }
  }
  UNION {
    # Keep the no-assessment fallback scoped to this pump as well.
    ?pump a mep:Pump .
    FILTER NOT EXISTS { ?pump supply:hasClassificationSuggestion ?otherSuggestion }
    FILTER NOT EXISTS { ?pump supply:hasClassificationAssessment ?otherAssessment }
    BIND("unresolved" AS ?status)
  }
  BIND(COALESCE(?selectedReview, ?pump) AS ?review)
  OPTIONAL {
    ?review supply:hasObservation ?observation .
    ?observation supply:sourcePropertySetName ?propertySet ;
                 supply:sourcePropertyName ?property ;
                 supply:sourceValue ?value .
    BIND(DATATYPE(?value) AS ?datatype)
    OPTIONAL { ?observation supply:sourceUnit ?unit }
  }
  OPTIONAL { ?review supply:evidence ?support }
  OPTIONAL { ?review supply:contradiction ?conflict }
  OPTIONAL { ?review supply:missingInformation ?missing }
}
ORDER BY ?identifier ?candidate ?property
