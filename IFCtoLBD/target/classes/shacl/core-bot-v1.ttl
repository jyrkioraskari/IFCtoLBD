@prefix bot: <https://w3id.org/bot#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <https://w3id.org/ifctolbd/shapes/core-bot/v1#> .

shapes:SiteBuildingShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bot:hasBuilding ;
    sh:property [ sh:path bot:hasBuilding ; sh:class bot:Building ] .

shapes:BuildingStoreyShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bot:hasStorey ;
    sh:property [ sh:path bot:hasStorey ; sh:class bot:Storey ] .

shapes:StoreySpaceShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bot:hasSpace ;
    sh:property [ sh:path bot:hasSpace ; sh:class bot:Space ] .

shapes:ContainedElementShape
    a sh:NodeShape ;
    sh:targetSubjectsOf bot:containsElement ;
    sh:property [ sh:path bot:containsElement ; sh:class bot:Element ] .
