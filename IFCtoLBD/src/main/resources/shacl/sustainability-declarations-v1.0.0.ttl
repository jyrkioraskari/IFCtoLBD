@prefix sust: <https://w3id.org/ifctolbd/sustainability#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shapes: <https://w3id.org/ifctolbd/shapes/sustainability-declarations/v1.0.0#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix ids: <https://w3id.org/ifctolbd/supply-chain#> .

shapes:DeclarationShape a sh:NodeShape ; sh:targetClass sust:EnvironmentalProductDeclaration ;
    sh:property [ sh:path sust:declarationId ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 1 ] ;
    sh:property [ sh:path sust:validUntil ; sh:maxCount 1 ; sh:datatype xsd:date ] .
shapes:IndicatorShape a sh:NodeShape ; sh:targetClass sust:EmbodiedCarbonIndicator ;
    sh:property [ sh:path sust:lifeCycleModule ; sh:minCount 1 ; sh:in ( "A1-A3" "A4" "C3" "D" ) ] ;
    sh:property [ sh:path ids:indicatorValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:class qudt:QuantityValue ] .
shapes:QuantityValueShape a sh:NodeShape ; sh:targetClass qudt:QuantityValue ;
    sh:property [ sh:path qudt:numericValue ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qudt:unit ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
