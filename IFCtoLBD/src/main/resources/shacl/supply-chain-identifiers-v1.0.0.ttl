@prefix ids: <https://w3id.org/ifctolbd/supply-chain#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shapes: <https://w3id.org/ifctolbd/shapes/supply-chain-identifiers/v1.0.0#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .

shapes:GlobalTradeItemNumberShape a sh:NodeShape ; sh:targetSubjectsOf ids:gtin ;
    sh:property [ sh:path ids:gtin ; sh:pattern "^[0-9]{8}([0-9]{4,6})?$" ; sh:maxCount 1 ] .
shapes:ManufacturerIdentifierShape a sh:NodeShape ; sh:targetSubjectsOf ids:manufacturerId ;
    sh:property [ sh:path ids:manufacturerId ; sh:minLength 1 ; sh:maxCount 1 ] .
shapes:DigitalLinkShape a sh:NodeShape ; sh:targetSubjectsOf ids:gs1DigitalLink ;
    sh:property [ sh:path ids:gs1DigitalLink ; sh:nodeKind sh:IRI ; sh:pattern "^https://id\\.gs1\\.org/01/[0-9]{14}$" ] .
shapes:MappingEvidenceShape a sh:NodeShape ; sh:targetClass ids:MappingEvidence ;
    sh:property [ sh:path ids:mappingMethod ; sh:minCount 1 ] ;
    sh:property [ sh:path ids:confidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .
shapes:ClassificationAssertionShape a sh:NodeShape ; sh:targetClass ids:ClassificationAssertion ;
    sh:property [ sh:path ids:code ; sh:minCount 1 ; sh:minLength 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ids:resolvedConcept ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .
shapes:NormalizedValueShape a sh:NodeShape ; sh:targetClass ids:PropertyValue ;
    sh:property [ sh:path schema:value ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path ids:mappingMethod ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path ids:confidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .
